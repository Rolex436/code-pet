{
  "name": "code-pet",
  "displayName": "Code Pet",
  "description": "A small animated coding companion that lives in the VS Code sidebar and reacts to your coding activity.",
  "version": "0.1.0",
  "publisher": "ice-cold911",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rolex436/code-pet"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codePet",
          "title": "Code Pet",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codePet": [
        {
          "type": "webview",
          "id": "codePet.petView",
          "name": "Pet",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codePet.show",
        "title": "Show Pet",
        "category": "Code Pet"
      },
      {
        "command": "codePet.reset",
        "title": "Reset Pet",
        "category": "Code Pet"
      }
    ],
    "configuration": {
      "title": "Code Pet",
      "properties": {
        "codePet.idleTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "description": "Seconds without coding before the pet settles into its idle state. It falls asleep after three times this long."
        },
        "codePet.gitReactions": {
          "type": "boolean",
          "default": true,
          "description": "Make the pet excited when you make a Git commit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}